# === TeleCodex 环境变量 ===

# 应用
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
# Mode: "polling" (local dev, no Redis/public URL) or "webhook" (production)
MODE=polling

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-here
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# Redis
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=telecodex

# Codex
CODEX_BIN=codex
CODEX_TIMEOUT_SEC=90
CODEX_MAX_OUTPUT_CHARS=12000
CODEX_CONCURRENCY_PER_USER=1
CODEX_GLOBAL_CONCURRENCY=4
